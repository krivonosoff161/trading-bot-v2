# Скопируй этот файл в .env и заполни своими ключами
# cp .env.example .env

# OKX API Keys
OKX_API_KEY=your_api_key_here
OKX_SECRET_KEY=your_secret_key_here
OKX_PASSPHRASE=your_passphrase_here

# Demo или реал: 0 = реал, 1 = демо
OKX_IS_DEMO=1

# Telegram bot token + chat IDs (никогда не коммитить реальные значения)
TELEGRAM_BOT_TOKEN=your_bot_token_here
PUMP_CHAT_ID=-100xxxxxxxxxx   # ID группы для pump-уведомлений (через запятую если несколько)
SCANNER_CHAT_ID=-100xxxxxxxxxx # ID канала/чата для info-edge scanner

# News scanner visible loop controls.
# The loop can also resolve mature outcomes after every scanner pass.
SCANNER_LOOP_LIMIT=3
SCANNER_LOOP_SLEEP_SECONDS=300
SCANNER_RUN_OUTCOMES=true
SCANNER_OUTCOME_LIMIT=25

# Raw public trades tape recorder
TAPE_DATA_DIR=D:\trading-data\ticks
TAPE_TOP_N_PAIRS=30
TAPE_KEEP_DAYS=365

# LLM provider for scout agents: yandex or alibaba
LLM_PROVIDER=yandex

# Yandex fallback
YANDEX_API_KEY=your_yandex_api_key_here
YANDEX_CHEAP_MODEL=
YANDEX_MID_MODEL=
YANDEX_CHIEF_MODEL=
YANDEX_AUDIT_MODEL=

# Alibaba Cloud Model Studio / OpenAI-compatible endpoint
ALIBABA_API_KEY=sk-ws-your_key_here
ALIBABA_BASE_URL=https://your-workspace.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
LLM_CHEAP_MODEL=qwen3-30b-a3b-instruct-2507
LLM_MID_MODEL=qwen3-next-80b-a3b-instruct
LLM_CHIEF_MODEL=qwen3.7-plus
LLM_AUDIT_MODEL=qwen3.7-plus
LLM_USD_RUB=90

# Scanner LLM budget guard. Caps set to 0 are disabled; non-zero caps are enforced by default.
LLM_STOP_ON_BUDGET=true
LLM_DAILY_RUB_CAP=100
LLM_SCAN_RUB_CAP=10
LLM_MAX_TOKENS_PER_SCAN=80000
LLM_MAX_CHIEF_PER_SCAN=5

# Optional source enrichment keys. Leave empty unless explicitly enabled.
TOKENOMIST_API_KEY=
EIA_API_KEY=

# Private research-lab output root. Results stay outside the public repo.
TRADING_BOT_RESEARCH_ROOT=%USERPROFILE%\github_projects\trading-bot-research\strategy-lab
AUTO_TRADE=false
